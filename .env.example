# Copy to .env and fill in. Never commit .env.

# Identities. Any long random strings; the role comes from which variable the token is in.
ANALYST_NAME=asha
ANALYST_TOKEN=change-me-analyst
REVIEWER_NAME=ravi
REVIEWER_TOKEN=change-me-reviewer

# Paths
DATABASE_PATH=./kasparro.db
PACK_DIR=./pack

# Model: replay (default, no key), stub (tests), live (needs key)
MODEL_MODE=replay
MODEL_NAME=
ANTHROPIC_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_MAX_ATTEMPTS=3
REPLAY_PATH=./eval/results/replay_cache/classify_v1.jsonl

# Review policy
REVIEW_TTL_HOURS=48
APPROVAL_TTL_HOURS=168
